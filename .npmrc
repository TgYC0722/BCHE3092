# npm runs lifecycle scripts with piped stdio; some sandboxed environments
# reject that with EPERM. Nothing in this project needs install scripts:
#  - esbuild ships its platform binary as an optional dependency
#  - the webR runtime is copied by vite.config.js when Vite starts
ignore-scripts=true
audit=false
fund=false

# Keep the download cache inside the project so `npm install` also works in
# environments where the default cache location (outside the workspace) is
# not writable.
cache=.npm-cache
